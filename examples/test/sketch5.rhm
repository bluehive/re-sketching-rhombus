#lang re_sketching
// Keyboard coloring.

fun setup():
  frame_rate(30)
  size(600, 400)

fun draw():
  stroke(255)
  cond
  | key_pressed:
      println(key)
      match key
      | Char"r": fill("red")
      | Char"g": fill("green")
      | Char"b": fill("blue")
      | ~else: fill("white")
      ellipse(mouse_x, mouse_y, 40, 40)
  | key_released:
      fill("white")
