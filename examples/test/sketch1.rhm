#lang re_sketching
// Equivalent of sketching-examples/test/sketch1 (Rhombus surface).
// Implemented by Grok.

fun draw():
  let n = frame_count
  background(125)
  stroke("red")
  stroke_weight(5)
  stroke_cap(#'round)
  stroke_join(#'miter)
  fill("green")
  line(150, 0, 150, height)
  line(0, 150, width, 150)
  ellipse(300, 300, 50, 100)
  ellipse_mode(#'corners)
  ellipse(150, 150, 50, 100)
  fill("blue")
  stroke("white")
  arc(50, 50, 100, 100, 0, 3.14)
  line(0, 0, width, height)
  ellipse_mode(#'center)
  stroke_weight(1)
  circle(width/2, height/2, 30)
  quad(300, 100, 300, 200, 400, 200, 400, 100)
  rect_mode(#'center)
  rect(300, 50, 20, 40, 5)
  triangle(10, 10, 20, 20, 0, 50)

def mutable value = 0

fun setup():
  size(600, 400)
  pixel_density(2)
  println([width, height])
  println([pixel_width, pixel_height])

fun on_mouse_pressed():
  match mouse_button
  | #'left: fill(255)
  | #'right: fill(0)
  | ~else: #void

fun on_mouse_dragged():
  value := value + 5
  when value > 255
  | value := 0

frame_rate(30)
