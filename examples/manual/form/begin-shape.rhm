#lang re_sketching
// Begin Shape / Vertex.
// begin_shape + vertex + end_shape で星形と開いた折れ線を描く。

fun star(cx, cy, r_outer, r_inner, n_points):
  begin_shape()
  def mutable i = 0
  while i < n_points * 2:
    let ang = -pi / 2.0 + i * pi / n_points
    // Rhombus: remainder is infix `mod`, not math.modulo
    let r = if (i mod 2) == 0 | r_outer | r_inner
    vertex(cx + r * math.cos(ang), cy + r * math.sin(ang))
    i := i + 1
  end_shape(#'close)

fun setup():
  size(640, 360)
  frame_rate(60)

fun draw():
  background(30)
  // 塗りつぶしの星
  fill(255, 204, 0)
  stroke(255)
  stroke_weight(2)
  star(width / 3.0, height / 2.0, 80, 35, 5)

  // 開いた折れ線（マウス）
  no_fill()
  stroke(100, 200, 255)
  stroke_weight(3)
  begin_shape()
  vertex(width / 2.0, height - 40)
  vertex(mouse_x, mouse_y)
  vertex(width - 40, height / 2.0)
  end_shape()

  // points モード
  stroke(255, 80, 80)
  stroke_weight(6)
  begin_shape(#'points)
  vertex(mouse_x - 20, mouse_y - 20)
  vertex(mouse_x + 20, mouse_y - 20)
  vertex(mouse_x, mouse_y + 20)
  end_shape()
