#lang re_sketching
// Regular Polygons.
// begin_shape / vertex で正多角形を描き、回転させる。
// Original: Processing RegularPolygon / Sketching regular-polygons

fun polygon(cx, cy, radius, npoints):
  let angle = 2.0 * pi / npoints
  begin_shape()
  def mutable i = 0
  while i < npoints:
    let a = i * angle
    vertex(cx + radius * math.cos(a), cy + radius * math.sin(a))
    i := i + 1
  end_shape(#'close)

fun setup():
  size(640, 360)
  frame_rate(60)

fun draw():
  background(102)
  no_stroke()
  fill(255)

  push_matrix()
  translate(0.2 * width, 0.5 * height)
  rotate(frame_count / 200.0)
  polygon(0, 0, 82, 3)
  pop_matrix()

  push_matrix()
  translate(0.5 * width, 0.5 * height)
  rotate(frame_count / 50.0)
  polygon(0, 0, 80, 20)
  pop_matrix()

  push_matrix()
  translate(0.8 * width, 0.5 * height)
  rotate(frame_count / -100.0)
  polygon(0, 0, 70, 7)
  pop_matrix()
