#lang re_sketching
// Arm.
// 2 セグメントの腕。mouse_x / mouse_y で各関節角を制御。
// Original: Processing Arm / Sketching arm

def mutable x = 0.0
def mutable y = 0.0
def seg_length = 100.0

fun setup():
  size(640, 360)
  stroke_weight(30)
  stroke(255, 160)
  x := 0.3 * width
  y := 0.5 * height

fun segment(sx, sy, a):
  translate(sx, sy)
  rotate(a)
  line(0, 0, seg_length, 0)

fun draw():
  background(0)
  let angle1 = -1.0 * pi * (mouse_x / width - 0.5)
  let angle2 = -1.0 * pi * (mouse_y / height - 0.5)
  push_matrix()
  segment(x, y, angle1)
  segment(seg_length, 0, angle2)
  pop_matrix()
